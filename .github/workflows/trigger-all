name: Trigger All Workflows

on:
  schedule:
    - cron: '*/5 * * * *'   # هر 5 دقیقه یکبار
  workflow_dispatch:        

jobs:
  trigger-all:
    runs-on: ubuntu-latest
    permissions:
      actions: write        
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: List all workflows
        id: list-workflows
        run: |
          # دریافت لیست تمام workflowها از طریق API
          curl -s -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
            "https://api.github.com/repos/${{ github.repository }}/actions/workflows" \
            > workflows.json
          # استخراج نام فایل‌های workflow (فقط workflowهای فعال)
          jq -r '.workflows[] | select(.state == "active") | .name' workflows.json > workflow-names.txt
          echo "Found workflows:"
          cat workflow-names.txt

      - name: Trigger each workflow
        run: |
          # خواندن نام workflowها و اجرای هر کدام با workflow_dispatch
          while IFS= read -r workflow_name; do
            # نام workflow ممکن است شامل فاصله باشد، پس باید encode شود
            encoded_name=$(echo "$workflow_name" | sed 's/ /%20/g')
            echo "Triggering workflow: $workflow_name"
            curl -X POST \
              -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
              -H "Accept: application/vnd.github.v3+json" \
              "https://api.github.com/repos/${{ github.repository }}/actions/workflows/$encoded_name/dispatches" \
              -d '{"ref":"main"}'  
          done < workflow-names.txt
